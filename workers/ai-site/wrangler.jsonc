{
  // worlddigital.ai company site + blog + blog editor (see README.md).
  // LIVE on worlddigital.ai/* since 2026-10-16. Rollback: comment out "routes" and redeploy.
  // The workers.dev address stays as a noindex preview.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worlddigital-ai-site",
  "main": "src/index.js",
  "account_id": "7a05f2ae447b2e57f5c902dc6f593d22",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.md"], "fallthrough": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none" },
  "services": [{ "binding": "REPORT", "service": "worlddigital-report" }],
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": {
    "ADMIN_EMAILS": "ahmad.awwad@worlddigital.ai",
    "NOTIFY_EMAIL": "support@worlddigital.ai",
    "MAIL_FROM": "WorldDigital.ai <login@worlddigital.ai>",
    "PING_SEARCH": "1",
    // Cloudflare Turnstile (human check). Set TS_REQUIRED to "1" once worlddigital.ai is on the widget's hostname list.
    "TS_SITEKEY": "0x4AAAAAAFRt-4be4VSc7r_H",
    "TS_REQUIRED": "1",
    // Python tools API (backend/). Empty = /api/tools answers "being set up". Secret: TOOLS_API_TOKEN
    "TOOLS_API_URL": "https://worlddigital-ai-api-250920469327.us-central1.run.app"
  },
  // Secret (set by the deploy workflow from the GitHub secret of the same name): RESEND_API_KEY
  "triggers": { "crons": ["23 * * * *"] },
  "routes": [
    { "pattern": "worlddigital.ai/*", "zone_name": "worlddigital.ai" }
  ],
  "observability": { "enabled": true }
}
